# Copy to .env and adjust for your local setup. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Origins allowed to call this API (comma-separated), e.g. the dashboard's dev server.
CORS_ORIGINS=["http://localhost:5173"]

# Mongo Atlas connection string and database name.
MONGODB_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net
MONGODB_DB=patient_registration

# The key configured as the webhook/signature key on the Retell agent.
# Used to verify X-Retell-Signature on every /retell/* request.
RETELL_API_KEY=

# Public base URL of this deployment (Railway URL), used by scripts/deploy_retell_flow.py
# to rewrite tool URLs in retell/conversation_flow.json before pushing it.
PUBLIC_BASE_URL=https://YOUR-BACKEND.up.railway.app

# Required X-API-Key header value for the read-only REST API (/api/*, except /api/health).
API_READ_KEY=

# Local debugging only. Skips X-Retell-Signature verification when true.
# A loud warning is logged at startup if this is true. Never set true in production.
ALLOW_UNSIGNED_REQUESTS=false
