# Copy to .env.local (gitignored) for local development.

# Backend to talk to. Defaults to the Railway deployment.
VITE_API_BASE_URL=http://localhost:8000

# The backend's API_KEY (API_READ_KEY). When set, the dashboard skips the
# sign-in screen. VITE_* values are baked into the built bundle, so never set
# this on a publicly hosted build.
VITE_API_KEY=
